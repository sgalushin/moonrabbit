OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash
SPEECH_MODEL=fish-audio/s2.1-pro
PORT=9850
LOCALSTACK_TOKEN=

# Local-only service; exposed hosts and Lambda/deployed modes are rejected.
RUNTIME_MODE=local
HOST=127.0.0.1
DEV_USER=local
LOCALSTACK_ENDPOINT=http://127.0.0.1:4566
TABLE_NAME=moonrabbit
BUCKET_NAME=moonrabbit-audio

# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are for deployment only.
# Local runs use LocalStack. The deployed site signs in with Cognito.
